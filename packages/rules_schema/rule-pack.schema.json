{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules.local/schemas/rule-pack.schema.json",
  "title": "RulePackVersion",
  "description": "Platform governance metadata wrapping a GoRules JSON Decision Model (JDM).",
  "type": "object",
  "required": ["domain", "pack_id", "version", "lifecycle", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "domain": { "type": "string", "minLength": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "published", "retired"]
    },
    "nodes": {
      "type": "array",
      "description": "JDM nodes (input, decisionTable, expression, switch, function, output, …)",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "edges": {
      "type": "array",
      "description": "JDM edges connecting nodes",
      "items": { "type": "object" }
    }
  }
}
