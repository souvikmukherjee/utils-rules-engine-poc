{
  "domain": "lounge",
  "pack_id": "lounge-access",
  "version": "1.0.0",
  "lifecycle": "published",
  "rules": [
    {
      "id": "tier-gold-lounge",
      "name": "Gold tier members get lounge access",
      "priority": 100,
      "enabled": true,
      "effective_from": "2024-01-01T00:00:00Z",
      "effective_to": null,
      "condition": {
        "path": "membership.tier",
        "op": "in",
        "value": ["gold", "platinum", "diamond"]
      },
      "effects": [
        {
          "type": "allow",
          "payload": { "lounge_class": "domestic" },
          "persist_as_entitlement": false
        },
        {
          "type": "grant_access",
          "payload": { "lounge_class": "domestic" },
          "persist_as_entitlement": true,
          "on_pack_change": "honor_existing",
          "benefit_type": "lounge_access"
        }
      ]
    },
    {
      "id": "partner-elite-access",
      "name": "Partner airline elite status grants access",
      "priority": 90,
      "enabled": true,
      "effective_from": "2024-01-01T00:00:00Z",
      "effective_to": null,
      "condition": {
        "all": [
          { "path": "partner.airline", "op": "exists", "value": true },
          {
            "path": "partner.elite_tier",
            "op": "in",
            "value": ["gold", "platinum", "first"]
          }
        ]
      },
      "effects": [
        {
          "type": "allow",
          "payload": { "reason": "partner_elite" },
          "persist_as_entitlement": false
        },
        {
          "type": "grant_access",
          "payload": { "lounge_class": "domestic", "via": "partner" },
          "persist_as_entitlement": true,
          "on_pack_change": "honor_existing",
          "benefit_type": "lounge_access"
        }
      ]
    },
    {
      "id": "companion-plus-one",
      "name": "Eligible members may bring one companion",
      "priority": 80,
      "enabled": true,
      "effective_from": "2024-01-01T00:00:00Z",
      "effective_to": null,
      "condition": {
        "any": [
          {
            "path": "membership.tier",
            "op": "in",
            "value": ["platinum", "diamond"]
          },
          { "path": "membership.companion_eligible", "op": "eq", "value": true }
        ]
      },
      "effects": [
        {
          "type": "grant_access",
          "payload": { "companions_allowed": 1 },
          "persist_as_entitlement": true,
          "on_pack_change": "honor_existing",
          "benefit_type": "companion_pass"
        }
      ]
    },
    {
      "id": "seasonal-peak-deny-silver",
      "name": "Seasonal: silver blocked during peak (starts in the future)",
      "priority": 200,
      "enabled": true,
      "effective_from": "2099-01-01T00:00:00Z",
      "effective_to": "2099-12-31T23:59:59Z",
      "condition": {
        "path": "membership.tier",
        "op": "eq",
        "value": "silver"
      },
      "effects": [
        {
          "type": "deny",
          "payload": { "reason": "peak_season_restriction" },
          "persist_as_entitlement": false
        }
      ]
    }
  ]
}
